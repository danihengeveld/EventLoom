<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The contract analyzer ships inside the EventLoom package so every consumer receives it. -->
  <ItemGroup>
    <ProjectReference Include="..\EventLoom.Analyzers\EventLoom.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="..\EventLoom.Analyzers\bin\$(Configuration)\netstandard2.0\EventLoom.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
