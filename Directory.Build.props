<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <EventLoomPackageVersion>0.1.0-alpha.0</EventLoomPackageVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsEventLoomPackage Condition="'$(MSBuildProjectName)' == 'EventLoom'">true</IsEventLoomPackage>
    <IsEventLoomPackage Condition="'$(MSBuildProjectName)' == 'EventLoom.EntityFrameworkCore'">true</IsEventLoomPackage>
    <IsEventLoomPackage Condition="'$(MSBuildProjectName)' == 'EventLoom.Hosting'">true</IsEventLoomPackage>
    <IsEventLoomPackage Condition="'$(MSBuildProjectName)' == 'EventLoom.AspNetCore'">true</IsEventLoomPackage>
    <IsEventLoomPackage Condition="'$(MSBuildProjectName)' == 'EventLoom.Analyzers'">true</IsEventLoomPackage>
    <IsEventLoomPackage Condition="'$(MSBuildProjectName)' == 'EventLoom.EntityFrameworkCore.PostgreSql'">true</IsEventLoomPackage>
    <IsEventLoomPackage Condition="'$(MSBuildProjectName)' == 'EventLoom.EntityFrameworkCore.Sqlite'">true</IsEventLoomPackage>
    <IsEventLoomPackage Condition="'$(MSBuildProjectName)' == 'EventLoom.Testing'">true</IsEventLoomPackage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsEventLoomPackage)' == 'true'">
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <Version>$(EventLoomPackageVersion)</Version>
    <Authors>Dani Hengeveld</Authors>
    <Company>Dani Hengeveld</Company>
    <Copyright>Copyright (c) 2026 Dani Hengeveld</Copyright>
    <PackageProjectUrl>https://github.com/danihengeveld/EventLoom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/danihengeveld/EventLoom.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>EventLoom event sourcing framework component.</Description>
    <PackageTags>event-sourcing;ef-core;postgresql;sqlite</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>eventloom-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup>
    <Description Condition="'$(MSBuildProjectName)' == 'EventLoom'">Core abstractions for building versioned event-sourced aggregates with EventLoom.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'EventLoom.EntityFrameworkCore'">Infrastructure dependency containing EF Core event-store persistence, aggregate repositories, snapshots, projections, and outbox support for EventLoom.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'EventLoom.Hosting'">Application composition, background-worker, health-check, and OpenTelemetry integration for EventLoom.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'EventLoom.AspNetCore'">ASP.NET Core endpoint integration for EventLoom health checks.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'EventLoom.Analyzers'">Roslyn analyzers for EventLoom event contracts.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'EventLoom.EntityFrameworkCore.PostgreSql'">PostgreSQL storage provider with distributed append and worker correctness for EventLoom.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'EventLoom.EntityFrameworkCore.Sqlite'">SQLite storage provider for local and controlled single-node EventLoom deployments.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'EventLoom.Testing'">Aggregate scenario testing and a managed SQLite test host for EventLoom.</Description>
    <PackageTags Condition="'$(MSBuildProjectName)' == 'EventLoom.EntityFrameworkCore.PostgreSql'">event-sourcing;ef-core;postgresql;event-store</PackageTags>
    <PackageTags Condition="'$(MSBuildProjectName)' == 'EventLoom.EntityFrameworkCore.Sqlite'">event-sourcing;ef-core;sqlite;event-store</PackageTags>
    <PackageTags Condition="'$(MSBuildProjectName)' == 'EventLoom.Testing'">event-sourcing;testing;aggregate-testing</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsEventLoomPackage)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <None Include="$(MSBuildThisFileDirectory)assets/eventloom-icon.png" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>