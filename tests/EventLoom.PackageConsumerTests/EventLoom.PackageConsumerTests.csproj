<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EventLoom" Version="$(EventLoomPackageVersion)" />
    <PackageReference Include="EventLoom.EntityFrameworkCore" Version="$(EventLoomPackageVersion)" />
    <PackageReference Include="EventLoom.EntityFrameworkCore.PostgreSql" Version="$(EventLoomPackageVersion)" />
    <PackageReference Include="EventLoom.EntityFrameworkCore.Sqlite" Version="$(EventLoomPackageVersion)" />
    <PackageReference Include="EventLoom.Hosting" Version="$(EventLoomPackageVersion)" />
    <PackageReference Include="EventLoom.Testing" Version="$(EventLoomPackageVersion)" />
  </ItemGroup>
</Project>
